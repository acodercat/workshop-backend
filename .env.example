db_uri=postgresql+psycopg://user:password@localhost:5432/dbname
secret_key=change-me-to-a-random-secret-key
redis_url=redis://localhost:6379/0
# Fernet key for encrypting Connector (MCP server) credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be identical to the worker's mcp_credential_encryption_key.
# mcp_credential_encryption_key=
# Public OAuth callback for MCP Connectors — where the provider redirects the
# browser back. Must equal {your app origin}/api/connectors/oauth/callback and,
# for manual OAuth apps, be registered as the redirect URI. Empty → OAuth
# connectors are disabled.
# mcp_oauth_redirect_uri=https://app.example.com/api/connectors/oauth/callback
# TTL (seconds) for the pending OAuth-authorization state held in Redis.
# Optional; defaults to 600.
# mcp_oauth_state_ttl_seconds=600
# Public URL of our OAuth client metadata document (CIMD) — this URL becomes
# our client_id, and the authorization server fetches it instead of us
# registering. Must be https with a non-root path and must point at this API's
# GET /api/connectors/client-metadata. Empty → fall back to dynamic client
# registration (still required for servers that don't advertise CIMD).
# mcp_client_metadata_url=https://api.example.com/api/connectors/client-metadata
# OSS — required, no defaults
oss_access_key_id=replace-with-your-oss-key-id
oss_access_key_secret=replace-with-your-oss-key-secret
# Optional: custom domain (CNAME) bound to the document bucket so inline
# HTML previews render instead of force-downloading on the default
# *.aliyuncs.com endpoint. e.g. https://files.metaseq.com.cn
# oss_document_domain=

# LLM (used for backend-side helpers like session-title generation)
llm_base_url=https://api.example.com/v1
llm_api_key=replace-with-your-llm-api-key

# CORS — JSON list. Add your frontend origin(s).
cors_origins=["http://localhost:3300"]

# Observability (all optional).
# Sentry stays disabled until a DSN is set.
# sentry_dsn=
# sentry_environment=production
# sentry_traces_sample_rate=0.0
# Prometheus /metrics is on by default; set to false to disable.
# metrics_enabled=true

# Payments — 汇付斗拱 (Huifu Dougong) recharge. Off by default; the
# endpoints return 403 until payment_enabled=true. Generate the merchant
# keypair with scripts/gen_huifu_keys.sh, then fill in the values below.
# payment_enabled=false
# huifu_env=mertest          # 'mertest' (sandbox) | 'prod' (api.huifu.com)
# Identity — assigned by Huifu during 进件/对接 (see the 商户运营平台 / your
# Huifu integration contact):
# huifu_merchant_id=         # 商户号 (huifu_id)
# huifu_sys_id=              # 系统号 (sys_id)
# huifu_product_id=          # 产品号 (product_id)
# Keys — store the SINGLE-LINE base64 body (no PEM header/footer/newlines):
#   huifu_rsa_private_key = YOUR merchant private key (you generate it)
#   huifu_rsa_public_key  = HUIFU's platform public key (copy from the console)
# huifu_rsa_private_key=
# huifu_rsa_public_key=
# Public HTTPS async-notify URL Huifu calls back (must include /api/v1):
# huifu_notify_url=https://your.domain/api/v1/payments/webhooks/huifu
# Order bounds (defaults shown):
# payment_min_cny=1
# payment_max_cny=10000
# payment_order_ttl_seconds=1800

# Aliyun SMS (短信服务 / dysmsapi) — phone verification codes. Keys
# default to empty; a send fails loudly at call time until they're set.
# Reuse the DM/OSS AccessKey if that RAM user also has
# AliyunDysmsFullAccess, otherwise mint a dedicated pair. sign_name +
# template_code carry operator-approved defaults (config.py) — only the
# AccessKey is required to go live. Smoke-test with:
#   uv run python -m scripts.test_send_verify_sms --to <phone>
# aliyun_sms_access_key_id=
# aliyun_sms_access_key_secret=
# aliyun_sms_sign_name=水杉智算深圳技术       # approved 短信签名 (no 【】)
# aliyun_sms_template_code=SMS_305451063     # approved 模板, variable ${code}
# aliyun_sms_region=cn-hangzhou              # cn-hangzhou | ap-southeast-1
