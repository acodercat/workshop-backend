db_uri=postgresql+psycopg://user:password@localhost:5432/dbname
secret_key=change-me-to-a-random-secret-key
redis_url=redis://localhost:6379/0

# OSS — required, no defaults
oss_access_key_id=
oss_access_key_secret=

# LLM (used for backend-side helpers like session-title generation)
llm_base_url=https://api.example.com/v1
llm_api_key=

# CORS — JSON list. Add your frontend origin(s).
cors_origins=["http://localhost:3300"]

# Observability (all optional).
# Sentry stays disabled until a DSN is set.
# sentry_dsn=
# sentry_environment=production
# sentry_traces_sample_rate=0.0
# Prometheus /metrics is on by default; set to false to disable.
# metrics_enabled=true

# Optional — overrides the default model_id stamped on new sessions.
# default_session_model_id=kimi-k2
